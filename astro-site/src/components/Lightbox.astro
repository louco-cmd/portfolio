---
// Full-screen image lightbox: zoom (wheel + loupe), lateral arrows, swipe & keyboard.
// Any <img data-lb> on the page is collected automatically.
---

<div class="lb-overlay" id="lb" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lb-close" data-lb-close aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" data-lb-prev aria-label="Previous image">‹</button>
  <button class="lb-nav lb-next" data-lb-next aria-label="Next image">›</button>

  <figure class="lb-stage" data-lb-stage>
    <img class="lb-img" data-lb-img alt="" draggable="false" />
  </figure>

  <div class="lb-bar">
    <span class="lb-counter" data-lb-counter></span>
    <span class="lb-hint">Scroll / pinch to zoom · drag to pan · ← → to browse</span>
  </div>
</div>

<style>
  .lb-overlay {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    background: rgba(6, 6, 8, 0.94);
    backdrop-filter: blur(10px);
    opacity: 0; visibility: hidden;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }
  .lb-overlay.open { opacity: 1; visibility: visible; }

  .lb-stage {
    margin: 0;
    max-width: 92vw; max-height: 86vh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    cursor: zoom-in;
    touch-action: none;
  }
  .lb-stage.zoomed { cursor: grab; }
  .lb-stage.zoomed.panning { cursor: grabbing; }

  .lb-img {
    max-width: 92vw; max-height: 86vh;
    width: auto; height: auto;
    object-fit: contain;
    border-radius: var(--radius, 10px);
    user-select: none;
    transform-origin: 0 0;
    transition: transform 0.08s linear, opacity 0.2s ease;
    will-change: transform;
  }
  .lb-img.swapping { opacity: 0; }

  .lb-close, .lb-nav {
    position: fixed; z-index: 2;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line-strong, rgba(255,255,255,0.18));
    color: var(--text, #ebecef);
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    backdrop-filter: blur(6px);
  }
  .lb-close:hover, .lb-nav:hover {
    background: var(--text, #ebecef); color: var(--bg, #0a0a0c);
    border-color: var(--text, #ebecef);
  }

  .lb-close {
    top: 20px; right: 20px;
    width: 44px; height: 44px; border-radius: 50%;
    font-size: 16px;
  }
  .lb-nav {
    top: 50%; transform: translateY(-50%);
    width: 52px; height: 52px; border-radius: 50%;
    font-size: 30px; line-height: 1; padding-bottom: 4px;
  }
  .lb-nav:hover { transform: translateY(-50%) scale(1.06); }
  .lb-prev { left: 20px; }
  .lb-next { right: 20px; }
  .lb-nav[hidden] { display: none; }

  .lb-bar {
    position: fixed; bottom: 18px; left: 0; right: 0;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    pointer-events: none;
  }
  .lb-counter {
    font-family: var(--font-medium, inherit);
    color: var(--text, #ebecef);
    font-size: 0.85rem; letter-spacing: 0.1em;
  }
  .lb-hint {
    color: var(--text-dim, #63656d);
    font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
  }

  :global(img[data-lb]) { cursor: zoom-in; }

  @media (max-width: 640px) {
    .lb-nav { width: 44px; height: 44px; font-size: 24px; }
    .lb-prev { left: 10px; }
    .lb-next { right: 10px; }
    .lb-hint { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb-overlay, .lb-img, .lb-nav, .lb-close { transition: none; }
  }
</style>

<script>
  const overlay = document.getElementById('lb');
  if (overlay) {
    const imgEl = overlay.querySelector('[data-lb-img]') as HTMLImageElement;
    const stage = overlay.querySelector('[data-lb-stage]') as HTMLElement;
    const counter = overlay.querySelector('[data-lb-counter]') as HTMLElement;
    const prevBtn = overlay.querySelector('[data-lb-prev]') as HTMLButtonElement;
    const nextBtn = overlay.querySelector('[data-lb-next]') as HTMLButtonElement;
    const closeBtn = overlay.querySelector('[data-lb-close]') as HTMLButtonElement;

    const sources = Array.from(document.querySelectorAll('img[data-lb]')) as HTMLImageElement[];
    let index = 0;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    const MIN = 1;
    const MAX = 5;

    const apply = () => {
      imgEl.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      stage.classList.toggle('zoomed', scale > 1);
    };

    const resetZoom = () => { scale = 1; tx = 0; ty = 0; apply(); };

    const clampPan = () => {
      // keep image within stage bounds when zoomed
      const r = imgEl.getBoundingClientRect();
      const sr = stage.getBoundingClientRect();
      const maxX = Math.max(0, (r.width - sr.width) / 2);
      const maxY = Math.max(0, (r.height - sr.height) / 2);
      tx = Math.min(maxX, Math.max(-maxX, tx));
      ty = Math.min(maxY, Math.max(-maxY, ty));
    };

    const show = (i: number) => {
      index = (i + sources.length) % sources.length;
      const src = sources[index];
      imgEl.classList.add('swapping');
      const next = new Image();
      next.onload = () => {
        imgEl.src = next.src;
        imgEl.alt = src.alt || '';
        resetZoom();
        imgEl.classList.remove('swapping');
      };
      next.src = src.currentSrc || src.src;
      counter.textContent = `${index + 1} / ${sources.length}`;
      const multi = sources.length > 1;
      prevBtn.hidden = !multi;
      nextBtn.hidden = !multi;
    };

    const open = (i: number) => {
      show(i);
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      resetZoom();
    };

    sources.forEach((img, i) => {
      img.addEventListener('click', () => open(i));
    });

    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); show(index - 1); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); show(index + 1); });
    closeBtn.addEventListener('click', close);

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    // Wheel / trackpad zoom, centered on cursor
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = imgEl.getBoundingClientRect();
      const ox = e.clientX - (rect.left + rect.width / 2);
      const oy = e.clientY - (rect.top + rect.height / 2);
      const prev = scale;
      scale = Math.min(MAX, Math.max(MIN, scale - e.deltaY * 0.0022 * scale));
      if (scale === prev) return;
      const factor = scale / prev;
      tx = (tx - ox) * factor + ox;
      ty = (ty - oy) * factor + oy;
      if (scale === 1) { tx = 0; ty = 0; } else { clampPan(); }
      apply();
    }, { passive: false });

    // Click image: toggle loupe zoom at cursor
    imgEl.addEventListener('click', (e) => {
      e.stopPropagation();
      if (scale > 1) { resetZoom(); return; }
      const rect = imgEl.getBoundingClientRect();
      const ox = e.clientX - (rect.left + rect.width / 2);
      const oy = e.clientY - (rect.top + rect.height / 2);
      scale = 2.5;
      tx = -ox * (scale - 1);
      ty = -oy * (scale - 1);
      clampPan();
      apply();
    });

    // Drag to pan when zoomed
    let dragging = false, sx = 0, sy = 0, stx = 0, sty = 0, moved = false;
    const down = (x: number, y: number) => {
      if (scale <= 1) return;
      dragging = true; moved = false; sx = x; sy = y; stx = tx; sty = ty;
      stage.classList.add('panning');
    };
    const move = (x: number, y: number) => {
      if (!dragging) return;
      tx = stx + (x - sx); ty = sty + (y - sy);
      if (Math.abs(x - sx) + Math.abs(y - sy) > 4) moved = true;
      clampPan(); apply();
    };
    const up = () => { dragging = false; stage.classList.remove('panning'); };

    stage.addEventListener('mousedown', (e) => down(e.clientX, e.clientY));
    window.addEventListener('mousemove', (e) => move(e.clientX, e.clientY));
    window.addEventListener('mouseup', up);

    // Touch: swipe to browse (when not zoomed) + drag to pan (when zoomed)
    let tStartX = 0, tStartY = 0, tDx = 0;
    stage.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      tStartX = t.clientX; tStartY = t.clientY; tDx = 0;
      if (scale > 1) down(t.clientX, t.clientY);
    }, { passive: true });
    stage.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      tDx = t.clientX - tStartX;
      if (scale > 1) { move(t.clientX, t.clientY); }
    }, { passive: true });
    stage.addEventListener('touchend', () => {
      up();
      if (scale <= 1 && Math.abs(tDx) > 50) {
        show(tDx < 0 ? index + 1 : index - 1);
      }
    });

    // Keyboard
    window.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(index + 1);
      else if (e.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>

---
import { getCollection } from 'astro:content';

// Projects for the dropdown, ordered like the home grid.
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Back to home">
      <img src="/image/Cover Louis cochet.jpeg" alt="Louis Cochet" class="avatar" />
    </a>

    <nav class="header-nav">
      <div class="dropdown" data-dropdown>
        <button type="button" class="dd-toggle" aria-expanded="false" aria-haspopup="true">
          <span>Projects</span>
          <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
            <path d="M1 1l4.5 4L10 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="dd-menu" role="menu">
          {projects.map((p) => (
            <li role="none">
              <a role="menuitem" href={`/projects/${p.id}/`}>
                <span class="dd-name">{p.data.title}</span>
                <span class="dd-sub">{p.data.cardSubtitle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a
        href="https://www.linkedin.com/in/louis-cochet-9362b8135/"
        target="_blank"
        rel="noopener"
        class="li-link"
        aria-label="LinkedIn"
      >
        <img width="20" height="20" src="/image/LinkedIn logo.png" alt="" />
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(10, 10, 12, 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 12px;
  }

  /* Avatar = home link */
  .brand { display: inline-flex; border-radius: 50%; }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .brand:hover .avatar { transform: scale(1.06); border-color: var(--text); }

  .header-nav { display: flex; align-items: center; gap: var(--s-3); }

  /* Dropdown */
  .dropdown { position: relative; }
  .dd-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .dd-toggle:hover { border-color: var(--line-strong); background: var(--surface); }
  .dd-toggle svg { transition: transform 0.25s ease; color: var(--text-muted); }
  .dropdown.open .dd-toggle { border-color: var(--line-strong); background: var(--surface); }
  .dropdown.open .dd-toggle svg { transform: rotate(180deg); }

  .dd-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 300px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .dropdown.open .dd-menu { opacity: 1; transform: translateY(0); pointer-events: auto; }

  .dd-menu a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 9px;
    transition: background 0.2s ease;
  }
  .dd-menu a:hover { background: var(--surface-2); }
  .dd-name { color: var(--text); font-size: 0.95rem; }
  .dd-sub { color: var(--text-dim); font-size: 0.78rem; }

  .li-link { display: inline-flex; opacity: 0.85; transition: opacity 0.25s ease; }
  .li-link:hover { opacity: 1; }

  @media (max-width: 560px) {
    .dd-menu { min-width: min(78vw, 300px); }
    .dd-toggle span { display: none; }
    .dd-toggle { padding: 8px 12px; }
  }
</style>

<script>
  document.querySelectorAll('[data-dropdown]').forEach((dd) => {
    const toggle = dd.querySelector('.dd-toggle');
    if (!toggle) return;
    const close = () => {
      dd.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = dd.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') close();
    });
  });
</script>

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'Dive into my Product Design portfolio: a blend of intuitive design, innovation, and user-focused solutions.',
  image = '/image/OG image.svg',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H7G5JXQGLZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-H7G5JXQGLZ');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
